func _fixture_bytes() -> PackedByteArray:
	return FileAccess.get_file_as_bytes(source_path).decompress_dynamic(1000000, FileAccess.COMPRESSION_GZIP)

func _sha256(bytes: PackedByteArray) -> String:
	var hasher := HashingContext.new()
	hasher.start(HashingContext.HASH_SHA256)
	hasher.update(bytes)
	return hasher.finish().hex_encode()

func _assert_source_intact() -> void:
	_expect(_sha256(_fixture_bytes()) == FIXTURE_HASHES[fixture_case], "The immutable source fixture remains byte-identical.")


