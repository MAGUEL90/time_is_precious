extends "res://scenes/test_scenes/test_scene_city_sleep_save.gd"

## Run one synthetic pre-removal checkpoint per isolated Godot process/profile.
## Fixture hashes identify checkpoints generated by the original 35969dc code.
const FIXTURE_HASHES := {
	"stocked": "61493082ed3e6af4f9c3a01185ed8681bccfbcb0ea199ff77dcc3b3346460ce2",
	"idle": "266741b39f86bba43fda75394cfed0347626ce88480e58a17578e896a9237a14",
	"outbound": "cc28baaf8f48441e82d49426c1d6bd0da213683d5bbc20af7d755766ad84fd11",
	"resigning": "dd61325e69d53e66364613e05c5a823bc2fda84ca0aa0c88d529f6ee7a0f80ef",
	"returning": "c1dfa9aa3e1f8fbb7afa61d4e8feb56809469928c82801fc7a3a1ebd0838010d",
	"returning_loaded": "fe3762e2456a22942d032d80c6e9aeb76af570b1f6cd290ef724d71fd4cf39f9",
	"returning_loaded_resigning": "be3b43d79618ea677f8f8bc424c9d67a45c9313ca4ce20263166a829e5227331",
	"city_outbound": "b3eafccbbcd2e212bde5d415c3b00c442e8852347fcc713cb009fa25c283dd2b",
}
const FIXTURE_SITES := {
	"clay_lump": "ClaySiteA", "wood_log": "WoodSite", "reed_bundle": "ReedSite",
	"straw_bundle": "StrawSite", "water_jar": "WaterSite",
}
const REMOVED_ENDPOINTS := ["ClayStorage", "WoodStorage", "ReedStorage", "StrawStorage", "WaterStorage"]

var fixture_case: String = ""
var source_path: String = ""
var test_path: String = ""
var original_bytes: PackedByteArray
var evidence: Dictionary = {}
var watched_pickup: PickUpItem
var watcher_active: bool = false
var watcher_calls: int = 0
var delivery_events: int = 0
var delivery_units: int = 0
var resignation_events: int = 0
var reject_city: bool = false
var resign_in_flight: bool = false


func _run() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--case="):
			fixture_case = arg.trim_prefix("--case=")
		elif arg == "--reject-city":
			reject_city = true
		elif arg == "--resign-in-flight":
			resign_in_flight = true
	if not FIXTURE_HASHES.has(fixture_case):
		_abort("Pass one supported --case value.")
		return
	if (reject_city or resign_in_flight) and fixture_case != "city_outbound":
		_abort("City rejection/resignation variants require --case=city_outbound.")
		return
	var data_root: String = OS.get_environment("XDG_DATA_HOME")
	if OS.get_name() == "Linux":
		if data_root.is_empty() or not data_root.is_absolute_path():
			_abort("Set an isolated absolute XDG_DATA_HOME for this test.")
			return
		var user_root: String = ProjectSettings.globalize_path("user://").simplify_path()
		if not user_root.begins_with(data_root.simplify_path().trim_suffix("/") + "/"):
			_abort("Godot user data is not inside the isolated XDG_DATA_HOME.")
			return
	source_path = "res://scenes/test_scenes/fixtures/legacy_stockpile_v12/" + fixture_case + ".json.gz"
	original_bytes = _fixture_bytes()
	if original_bytes.is_empty() or _sha256(original_bytes) != FIXTURE_HASHES[fixture_case]:
		_abort("The synthetic pre-removal checkpoint is missing or has an unexpected hash.")
		return
	evidence = {
		"saved_inventory": {"shekel": 3} if fixture_case == "stocked" else {},
		"saved_city_storage_items": {"barley_bread": 12, "simple_clothes": 3} if fixture_case == "stocked" else {"barley_bread": 9},
	}
	test_path = "user://stockpile_migration_test/" + fixture_case + "/checkpoint.json"
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(test_path.get_base_dir())) != OK:
		_abort("Cannot create the isolated test directory.")
		return
	for suffix: String in ["", ".bak", ".tmp", ".pending"]:
		if FileAccess.file_exists(test_path + suffix):
			_abort("Refusing to overwrite an existing test checkpoint or recovery file.")
			return
	var copy := FileAccess.open(test_path, FileAccess.WRITE)
	if copy == null:
		_abort("Cannot write the isolated checkpoint copy.")
		return
	copy.store_buffer(original_bytes)
	copy.close()
	_snapshot_globals()
	TimeComponentManager.set_process(false)
	TimeComponentManager.is_paused = false
	get_tree().paused = false
	_reset_singletons_before_load()
	await _load_root_city()
	player.debug_disable_player_needs = true
	player.debug_disable_fatigue = true
	store.disk.path = test_path
	store.refresh_checkpoint_slot()
	for attempt: int in range(2):
		if not store.load_checkpoint():
			_abort("Legacy load failed on attempt %d: " % attempt + store.last_error)
			return
		ui.close_details()
		_assert_initial_state("old load %d" % attempt)
		_expect(FileAccess.get_file_as_bytes(test_path) == original_bytes, "Continue must not rewrite the copied v12 checkpoint.")
		_expect(not FileAccess.file_exists(test_path + ".bak"), "Continue must not create a backup.")
		_assert_source_intact()
	if failures != 0:
		_finish_fixture()
		return
	if not store.save_checkpoint():
		_abort("Cannot write upgraded checkpoint: " + store.last_error)
		return
	var upgraded: Variant = JSON.parse_string(FileAccess.get_file_as_string(test_path))
	_expect(upgraded is Dictionary and int(upgraded.get("schema_version", -1)) == 14, "Explicit Save writes schema 14.")
	_expect(FileAccess.get_file_as_bytes(test_path + ".bak") == original_bytes, "The first upgrade retains the exact old checkpoint in the backup.")
	for attempt: int in range(2):
		if not store.load_checkpoint():
			_abort("Upgraded checkpoint failed to load: " + store.last_error)
			return
		ui.close_details()
		_assert_initial_state("v%d load %d" % [store.snapshot.VERSION, attempt])
		_expect(FileAccess.get_file_as_bytes(test_path + ".bak") == original_bytes, "Repeated Continue preserves the original backup.")
	if failures == 0:
		if fixture_case == "stocked":
			_test_pickups()
			_test_legacy_ground_limit()
		else:
			_test_final_route()
	_assert_source_intact()
	_finish_fixture()


func _assert_initial_state(label: String) -> void:
	for endpoint: String in REMOVED_ENDPOINTS:
		_expect(runtime.get_node_or_null(endpoint) == null, label + ": removed stockpile node is absent: " + endpoint)
	_expect(runtime.get_node_or_null("CityStorageArea/DeliveryPoint") != null, label + ": CityStorage endpoint remains available.")
	_assert_totals(label)
	var wood_ground: int = 10 if fixture_case in ["stocked", "idle", "returning"] else 7
	for item: String in FIXTURE_SITES:
		var expected: int = {"clay_lump": 6, "wood_log": wood_ground, "reed_bundle": 6, "straw_bundle": 7, "water_jar": 8}[item]
		_expect(_ground_count(item) == expected, "%s: exact %s ground amount" % [label, item])
	_expect(_same_item_counts(Inventory.items, evidence.saved_inventory), label + ": inventory was not credited automatically.")
	_expect(_same_item_counts(city_storage.items, evidence.saved_city_storage_items), label + ": CityStorage was not credited automatically.")
	var route: Dictionary = runtime.hauling.routes.get(HAULER_ID, {})
	if fixture_case == "stocked":
		_expect(route.is_empty(), label + ": no Hauler was invented.")
		return
	var worker: WorkerData = WorkerDatabase.get_worker_data(HAULER_ID)
	_expect(worker != null, label + ": hired Hauler still exists.")
	if worker == null:
		return
	_expect(worker.profession == WorkerData.Profession.HAULER and worker.payroll_paid_until_day == 3,
		label + ": worker profession and prepaid contract are preserved.")
	_expect(city_storage.has_equipped(HAULER_ID, "cart"), label + ": original cart remains assigned during the route.")
	var expected_phase: String = "idle" if fixture_case == "idle" else ("returning" if fixture_case.begins_with("returning") else "outbound")
	var expected_destination: String = "CityStorageArea/DeliveryPoint" if fixture_case == "city_outbound" else "WoodStorage"
	var expected_cargo: int = 0 if fixture_case in ["idle", "returning"] else 3
	_expect(not route.is_empty(), label + ": the old route is still represented.")
	if route.is_empty():
		return
	_expect(str(route.phase) == expected_phase and str(route.destination_path) == expected_destination
		and int(route.cargo.quantity) == expected_cargo and str(route.cargo.item_id) == "wood_log",
		label + ": route phase, target and cargo match the saved fixture.")
	var was_resigning: bool = fixture_case in ["resigning", "returning_loaded_resigning"]
	_expect(bool(route.resigning) == was_resigning and worker.resignation_pending == was_resigning,
		label + ": pending resignation is preserved.")


func _test_final_route() -> void:
	var destination: StorageDestination = runtime.get_node("CityStorageArea/DeliveryPoint")
	if reject_city:
		destination.accepting_deliveries = false
	if resign_in_flight:
		CitizenManager.get_citizen(HAULER_ID).satisfaction = 0.0
		WorkerDatabase.resign_idle_workers_at_zero()
		var pending_worker: WorkerData = WorkerDatabase.get_worker_data(HAULER_ID)
		var pending_route: Dictionary = runtime.hauling.routes.get(HAULER_ID, {})
		_expect(pending_worker != null and pending_worker.resignation_pending
			and not pending_route.is_empty() and bool(pending_route.get("resigning", false))
			and int(pending_route.get("cargo", {}).get("quantity", 0)) == 3,
			"A live CityStorage shipment enters pending resignation without losing cargo.")
	destination.delivery_received.connect(_on_city_delivery)
	runtime.daily.resignation_ready.connect(_on_resignation_ready)
	var route: Dictionary = runtime.hauling.routes.get(HAULER_ID, {})
	if route.is_empty():
		_expect(false, "The saved route exists before advancing it.")
		return
	var xp_before: int = WorkerDatabase.get_worker_data(HAULER_ID).profession_xp
	var saved_target: Vector2 = route.target
	var expect_resignation: bool = fixture_case in ["resigning", "returning_loaded_resigning"] or resign_in_flight
	var until_arrival: int = maxi(1, int(route.arrival) - _clock_minute())
	if fixture_case in ["outbound", "resigning", "city_outbound", "returning_loaded", "returning_loaded_resigning"] and until_arrival > 1:
		_expect(TimeComponentManager.advance_minutes(until_arrival - 1), "The route advances to the minute before delivery.")
		route = runtime.hauling.routes.get(HAULER_ID, {})
		_expect(not route.is_empty() and int(route.get("cargo", {}).get("quantity", 0)) == 3,
			"The shipment is still carried just before its arrival.")
		_assert_totals("before delivery")
		if not store.save_checkpoint() or not store.load_checkpoint():
			_expect(false, "The in-flight current-schema route saves and Continues: " + store.last_error)
			return
		ui.close_details()
		_assert_totals("continued before delivery")
		route = runtime.hauling.routes.get(HAULER_ID, {})
		_expect(not route.is_empty() and int(route.get("cargo", {}).get("quantity", 0)) == 3,
			"Continue restores the same one in-flight shipment.")
		if reject_city:
			_expect(not destination.accepting_deliveries, "Continue retains the CityStorage rejection state.")
		if expect_resignation:
			var continued_worker: WorkerData = WorkerDatabase.get_worker_data(HAULER_ID)
			_expect(continued_worker != null and continued_worker.resignation_pending and bool(route.get("resigning", false)),
				"Continue retains the pending resignation and its final shipment.")
		until_arrival = maxi(1, int(route.get("arrival", _clock_minute() + 1)) - _clock_minute())
	_expect(TimeComponentManager.advance_minutes(until_arrival), "The remaining route reaches its boundary.")
	_assert_totals("after route boundary")
	if fixture_case == "returning_loaded_resigning":
		var retry: Dictionary = runtime.hauling.routes.get(HAULER_ID, {})
		_expect(not retry.is_empty() and retry.phase == "outbound" and int(retry.cargo.quantity) == 3,
			"A resigning worker carries the rejected load to its final destination.")
		if retry.is_empty():
			return
		if not store.save_checkpoint() or not store.load_checkpoint():
			_expect(false, "The final retry survives Save and Continue: " + store.last_error)
			return
		ui.close_details()
		retry = runtime.hauling.routes.get(HAULER_ID, {})
		_expect(not retry.is_empty() and int(retry.get("cargo", {}).get("quantity", 0)) == 3,
			"Continue keeps the same rejected load on the final trip.")
		if retry.is_empty():
			return
		_expect(TimeComponentManager.advance_minutes(maxi(1, int(retry.arrival) - _clock_minute())),
			"The final retry reaches the old destination.")
		_assert_totals("after rejected-load retry")
	var expected_city: int = 3 if fixture_case == "city_outbound" and not reject_city else 0
	var expected_delivery_events: int = 1 if expected_city == 3 else 0
	_expect(int(city_storage.items.get("wood_log", 0)) == expected_city, "CityStorage receives exactly the intended old delivery.")
	_expect(delivery_events == expected_delivery_events
		and delivery_units == expected_city, "The native CityStorage delivery signal fires exactly once only for its own route.")
	if fixture_case in ["outbound", "resigning", "returning_loaded", "returning_loaded_resigning"] or reject_city:
		_expect(_ground_count("wood_log") == 10, "The final removed-stockpile shipment reaches the ground exactly once.")
	if reject_city:
		_expect(_ground_at("wood_log", saved_target) == 3,
			"A refused CityStorage delivery leaves exactly the cargo at its original destination.")
	if expect_resignation:
		_expect(not WorkerDatabase.has_worker_data(HAULER_ID) and resignation_events == 1,
			"The pending Hauler resigns once after the final delivery.")
		var departed: WorkerData = WorkerDatabase.dismissed_workers.get(HAULER_ID)
		var citizen: CitizenData = CitizenManager.get_citizen(HAULER_ID)
		_expect(departed != null and departed.payroll_paid_until_day == -1
			and citizen != null and citizen.employment_status == CitizenData.EmploymentStatus.UNEMPLOYED,
			"Resignation forfeits the old contract and retains the unemployed citizen.")
		_expect(not city_storage.has_equipped(HAULER_ID, "cart"), "The resigned worker's cart is released.")
	else:
		var returning: Dictionary = runtime.hauling.routes.get(HAULER_ID, {})
		if not returning.is_empty():
			_expect(TimeComponentManager.advance_minutes(maxi(1, int(returning.arrival) - _clock_minute())), "Any return trip finishes.")
		var remaining_worker: WorkerData = WorkerDatabase.get_worker_data(HAULER_ID)
		_expect(remaining_worker != null and remaining_worker.payroll_paid_until_day == 3
			and not remaining_worker.is_reserved(), "The released Hauler remains hired with the same contract.")
		_expect(city_storage.has_equipped(HAULER_ID, "cart"), "The retained worker keeps the assigned cart.")
	_expect(not runtime.hauling.routes.has(HAULER_ID), "The completed legacy assignment has no remaining route.")
	_expect(TimeComponentManager.advance_minutes(15), "Further time can pass without a new Hauler task.")
	_expect(not runtime.hauling.routes.has(HAULER_ID) and int(city_storage.items.get("wood_log", 0)) == expected_city
		and delivery_events == expected_delivery_events and resignation_events == (1 if expect_resignation else 0),
		"Extra ticks cannot repeat the final delivery, resignation, or start a task.")
	var final_worker: WorkerData = WorkerDatabase.get_worker_data(HAULER_ID)
	if final_worker == null:
		final_worker = WorkerDatabase.dismissed_workers.get(HAULER_ID)
	var expected_xp: int = 3 if fixture_case in ["outbound", "resigning", "returning_loaded_resigning", "city_outbound"] and not reject_city else 0
	_expect(final_worker != null and final_worker.profession_xp == xp_before + expected_xp,
		"Delivery XP is awarded once on receipt, and not for a rejected CityStorage receipt.")
	_assert_totals("after additional ticks")
	if not store.save_checkpoint() or not store.load_checkpoint():
		_expect(false, "The completed route state saves and Continues: " + store.last_error)
		return
	ui.close_details()
	_assert_totals("after completed route Continue")
	_expect(not runtime.hauling.routes.has(HAULER_ID) and int(city_storage.items.get("wood_log", 0)) == expected_city,
		"Continue cannot recreate the completed route or repeat its receipt.")


func _test_pickups() -> void:
	var pile: PickUpItem = _legacy_pile("clay_lump")
	if pile == null:
		_expect(false, "Migrated clay exists as an individual collectible legacy pile.")
		return
	_expect(pile.quantity == 4, "The legacy clay pile holds the original four items.")
	Inventory.max_load = Inventory.get_total_inventory_weight()
	var empty_bag_count: int = int(Inventory.items.get("clay_lump", 0))
	pile.on_player_interact(player)
	_expect(int(Inventory.items.get("clay_lump", 0)) == empty_bag_count and pile.quantity == 4,
		"Zero remaining capacity leaves the whole legacy pile intact.")
	Inventory.max_load = Inventory.get_total_inventory_weight() + 4.0
	_watched_interact(pile)
	_expect(watcher_calls == 1 and int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 2 and pile.quantity == 2,
		"Partial pickup transfers exactly two clay despite synchronous reentry.")
	pile.on_player_interact(player)
	_expect(int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 2 and pile.quantity == 2,
		"Repeating with a full bag cannot duplicate a partial pickup.")
	_assert_totals("after partial pickup")
	if not store.save_checkpoint() or not store.load_checkpoint():
		_expect(false, "Partial pickup saves and Continues: " + store.last_error)
		return
	ui.close_details()
	pile = _legacy_pile("clay_lump")
	if pile == null:
		_expect(false, "The partial remainder survives Continue.")
		return
	_expect(pile.quantity == 2 and int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 2,
		"Continue preserves both partial inventory and the ground remainder.")
	Inventory.max_load = Inventory.get_total_inventory_weight() + 100.0
	_watched_interact(pile)
	_expect(watcher_calls == 1 and int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 4 and pile.is_collecting,
		"The remaining two clay are collected once despite synchronous reentry.")
	pile.on_player_interact(player)
	_expect(int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 4,
		"Repeated interaction during the pickup animation adds nothing.")
	_assert_totals("during full pickup animation")
	if not store.save_checkpoint() or not store.load_checkpoint():
		_expect(false, "A save during pickup animation Continues safely: " + store.last_error)
		return
	ui.close_details()
	_expect(_legacy_pile("clay_lump") == null and int(Inventory.items.get("clay_lump", 0)) == empty_bag_count + 4,
		"The full pickup is represented only in the bag after Continue.")
	_assert_totals("after full pickup Continue")


func _test_legacy_ground_limit() -> void:
	# A valid old checkpoint may already use all 10,000 regular ground slots.
	# Retired stock must remain separately encodable without mutating live state.
	var document: Dictionary = JSON.parse_string(original_bytes.get_string_from_utf8())
	var codec = MIGRATION_VALUES.new()
	var raw: Dictionary = codec.decode(document.state)
	var sample: Dictionary = raw.worksites.ground[0]
	while raw.worksites.ground.size() < 10000:
		raw.worksites.ground.append(sample.duplicate(true))
	document.state = codec.encode(raw)
	_expect(codec.error.is_empty(), "A maximum-size old ground list remains a valid encoded fixture.")
	var before: Dictionary = store.snapshot.capture(content)
	var valid: bool = store.snapshot.prepare(document, content)
	_expect(valid, "A full old ground list and stockpiles can be staged safely: " + store.snapshot.error)
	if valid:
		var staged: Dictionary = store.snapshot.prepared
		_expect(staged.worksites.ground.size() == 10000 and staged.worksites.legacy_ground.size() == 5,
			"All old ground entries and five migrated stock piles remain distinct.")
		var encoded: Variant = codec.encode(staged)
		_expect(codec.error.is_empty(), "The staged maximum-size migration can be encoded by the save codec.")
		var upgraded: Dictionary = {"schema_version": store.snapshot.VERSION, "scenario": "city_mvp", "location": "city", "state": encoded}
		_expect(JSON.stringify(upgraded, "\t", true, true).to_utf8_buffer().size() <= store.disk.MAX_FILE_BYTES,
			"The maximum-size ground fixture also fits the disk checkpoint limit.")
	_expect(_same_snapshot(before, store.snapshot.capture(content)), "The maximum-size staging probe does not alter the live world.")


func _watched_interact(pile: PickUpItem) -> void:
	watched_pickup = pile
	watcher_calls = 0
	watcher_active = true
	Inventory.items_changed.connect(_on_inventory_reentry)
	pile.on_player_interact(player)
	watcher_active = false
	Inventory.items_changed.disconnect(_on_inventory_reentry)


func _on_inventory_reentry() -> void:
	if not watcher_active:
		return
	watcher_calls += 1
	if watcher_calls > 1:
		_expect(false, "A reentrant inventory listener caused a second transfer.")
		return
	if is_instance_valid(watched_pickup):
		watched_pickup.on_player_interact(player)
	_assert_totals("synchronous inventory observer")


func _legacy_pile(item_id: String) -> PickUpItem:
	for node: Node in runtime.get_node("GroundOutput").get_children():
		if node is PickUpItem and not node.is_queued_for_deletion() and not node.is_collecting \
			and node.item_id == item_id and bool(node.get_meta("legacy_stockpile", false)):
			return node
	return null


func _ground_count(item_id: String) -> int:
	var count: int = 0
	for node: Node in runtime.get_node("GroundOutput").get_children():
		if node is PickUpItem and not node.is_queued_for_deletion() and not node.is_collecting and node.item_id == item_id:
			count += int(node.quantity)
	return count


func _same_item_counts(actual: Dictionary, expected: Variant) -> bool:
	# Inventory is a typed Dictionary; JSON evidence is an untyped Dictionary
	# and JSON numbers may be floats. Compare every key and exact whole quantity
	# rather than Dictionary type metadata or silently rounding a fraction.
	if not expected is Dictionary or actual.size() != expected.size():
		return false
	for item: Variant in expected:
		if typeof(item) != TYPE_STRING or not actual.has(item) or typeof(actual[item]) != TYPE_INT:
			return false
		var value: Variant = expected[item]
		if typeof(value) == TYPE_FLOAT:
			if not is_finite(value) or value < 0.0 or value > 9007199254740991.0 or floor(value) != value:
				return false
		elif typeof(value) != TYPE_INT:
			return false
		if int(value) != actual[item]:
			return false
	return true


func _ground_at(item_id: String, position: Vector2) -> int:
	var count: int = 0
	for node: Node in runtime.get_node("GroundOutput").get_children():
		if node is PickUpItem and not node.is_queued_for_deletion() and not node.is_collecting \
			and node.item_id == item_id and node.global_position.is_equal_approx(position):
			count += int(node.quantity)
	return count


func _assert_totals(label: String) -> void:
	var document: Dictionary = store.snapshot.capture(content)
	if document.is_empty():
		_expect(false, label + ": coherent snapshot can be captured: " + store.snapshot.error)
		return
	var codec = MIGRATION_VALUES.new()
	var raw: Variant = codec.decode(document.state)
	if not raw is Dictionary or not codec.error.is_empty():
		_expect(false, label + ": captured snapshot can be decoded.")
		return
	var totals: Dictionary = {}
	for item: String in FIXTURE_SITES:
		totals[item] = int(raw.worksites.sites[FIXTURE_SITES[item]].stock) \
			+ int(raw.inventory.items.get(item, 0)) + int(raw.city_storage.items.get(item, 0)) \
			+ int(raw.workshop_storage.items.get(item, 0))
	var saved_piles: Array = raw.worksites.ground.duplicate()
	saved_piles.append_array(raw.worksites.legacy_ground)
	for pile: Dictionary in saved_piles:
		if totals.has(pile.item_id):
			totals[pile.item_id] += int(pile.quantity)
	for pile: Dictionary in raw.city_drops:
		if totals.has(pile.item_id):
			totals[pile.item_id] += int(pile.quantity)
	for route: Dictionary in raw.worksites.routes.values():
		var cargo: Dictionary = route.cargo
		if totals.has(cargo.item_id):
			totals[cargo.item_id] += int(cargo.quantity)
	for item: String in FIXTURE_SITES:
		_expect(int(totals[item]) == 72, "%s: %s conserves all 72 items (got %d)." % [label, item, totals[item]])


